# Both stages resolve one approved multi-platform OCI index by digest, so the
# amd64 and arm64 release jobs cannot pick up two different base generations.
#
#   python:3.12-alpine  index sha256:e064671c…18d0fc7
#     linux/amd64       child sha256:a61cbd76…3618b20
#     linux/arm64/v8    child sha256:218ad6ba…d39249b
#
# tests/test_self_host_server_image_materials.py re-derives that index and both
# child descriptors from the registry, so a silent retag is a test failure.
FROM python:3.12-alpine@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7 AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1

# No apk layer: every runtime dependency resolves to a pure-Python or
# musllinux wheel, so nothing is compiled here and no Alpine repository is
# consulted. --require-hashes pins the exact bytes of every distribution and
# --only-binary=:all: forbids the sdist fallback that would reintroduce a
# toolchain and mutable source resolution.
#
# server/requirements.txt also records the manylinux x86_64 hashes the glibc CI
# runner needs. That cannot widen this build: pip's supported tags under musl
# never include manylinux, so the only hashes reachable from here are the
# musllinux and pure ones. tests/test_self_host_server_image_materials.py
# resolves all three environments and asserts exactly that separation.
COPY server/requirements.txt /requirements.txt
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r /requirements.txt

# --- Production stage ---
FROM python:3.12-alpine@sha256:e064671ca452259bab50e8e2c7bd896e39e9a343bb06ca25234adf6fe18d0fc7

ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF

ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONUNBUFFERED=1

# Copy installed packages from builder. The musllinux wheels vendor their own
# shared libraries (libpq, libffi, libsodium), so the runtime stage needs no
# Alpine packages either.
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Create non-root user
RUN addgroup -S etebase && adduser -S etebase -G etebase

# Copy application code
COPY server/ /app

# Create data directories and ensure entrypoint is executable
RUN mkdir -p /data /data/media /data/static && \
    chmod +x /app/docker/entrypoint.sh && \
    chown -R etebase:etebase /app /data

WORKDIR /app

# Run as non-root
USER etebase

EXPOSE 3735

ENTRYPOINT ["/app/docker/entrypoint.sh"]
