{
  "name": "silentsuite",
  "version": "0.4.2-beta",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "SilentSuite <info@silentsuite.io>",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:docs": "turbo build --filter=@silentsuite/docs",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "i18n:check": "pnpm --filter @silentsuite/web i18n:check",
    "i18n:report": "pnpm --filter @silentsuite/web i18n:report",
    "check:public-analytics": "node scripts/check-public-analytics.mjs && node --experimental-strip-types --test apps/docs/.vitepress/theme/public-analytics.test.mts",
    "audit:security": "node scripts/audit-high-critical.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "serialize-javascript": "^7.0.3",
      "flatted": "^3.4.2",
      "picomatch": "^4.0.4",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": "2.1.2",
      "brace-expansion@>=3.0.0 <5.0.8": "5.0.8",
      "fast-uri": "^3.1.4",
      "js-yaml": "^4.3.0",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "ws": "^7.5.11",
      "lodash": "^4.18.0",
      "vitepress>vite": "^6.4.3"
    }
  },
  "dependencies": {
    "sharp": "^0.35.0"
  }
}
