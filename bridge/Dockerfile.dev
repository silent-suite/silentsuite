FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

# etebase 0.32.0 ships abi3 wheels for Linux x86_64 and aarch64, so no Rust or
# native build dependencies are needed.

WORKDIR /app

# Copy project files
COPY pyproject.toml README.md LICENSE ./
COPY src/ src/
COPY tests/ tests/

# Install the bridge and dependencies
RUN pip install --no-cache-dir -e ".[dev]"

# Default command
CMD ["silentsuite-bridge", "--version"]
