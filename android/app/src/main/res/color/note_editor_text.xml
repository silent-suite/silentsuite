<?xml version="1.0" encoding="utf-8"?>
<!-- The note editor's fields have no underline, so a field the editor stopped (enabled false) shows it by its text:
     still easy to read and copy, in the secondary text color. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/semantic_on_surface_variant" />
    <item android:color="@color/semantic_on_surface" />
</selector>
