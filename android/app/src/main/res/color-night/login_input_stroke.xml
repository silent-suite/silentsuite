<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: lighter borders for visibility on dark backgrounds -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/semantic_focus" />
    <item android:state_hovered="true" android:color="@color/semantic_focus" />
    <item android:state_enabled="true" android:color="@color/semantic_outline" />
    <item android:color="@color/semantic_disabled_content" />
</selector>
