<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Why no note can be made or edited here: a read-only notebook, or a discard that did not finish. -->
    <TextView
        android:id="@+id/note_list_read_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_8"
        android:background="@color/semantic_surface_variant"
        android:padding="@dimen/spacing_16"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/semantic_on_surface"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/notes_new_note"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_8"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/notes_new_note"
        android:visibility="gone" />

    <!-- Says why the list shows the synced notes without the changes made on this device. -->
    <TextView
        android:id="@+id/notes_pending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_8"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/semantic_on_surface"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notes_unreadable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_8"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/semantic_on_surface_variant"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/notes_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/notes_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice" />

            <TextView
                android:id="@+id/notes_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_24"
                android:text="@string/notes_empty_notes"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/semantic_on_surface_variant"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
