<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notebooks_unsynced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_8"
        android:background="@color/semantic_surface_variant"
        android:padding="@dimen/spacing_16"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/semantic_on_surface"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notebooks_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_8"
        android:text="@string/notes_notebooks_hint"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/semantic_on_surface_variant" />

    <!-- The empty state sits inside the refresh layout so the spinner and pull to refresh stay
         available before the first sync and after a failure. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/notebooks_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ListView
                android:id="@+id/notebooks_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice" />

            <LinearLayout
                android:id="@+id/notebooks_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/spacing_24"
                android:visibility="gone">

                <TextView
                    android:id="@+id/notebooks_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/notes_empty_notebooks"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/semantic_on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/notebooks_create"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:text="@string/notes_new_notebook" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
