<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_event_row" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingEnd="4dp"
    android:background="@drawable/widget_touch_background">
    <ImageView android:id="@+id/widget_event_color" android:layout_width="4dp" android:layout_height="32dp"
        android:importantForAccessibility="no" android:background="@color/semantic_primary" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/widget_event_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/semantic_on_surface"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_event_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/semantic_on_surface_variant" />
    </LinearLayout>
</LinearLayout>
