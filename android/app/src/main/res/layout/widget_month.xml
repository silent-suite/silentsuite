<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_month_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_month_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_month_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="@string/widget_month_name"
            android:textColor="@color/semantic_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
        <ImageButton
            android:id="@+id/widget_month_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_month_control_background"
            android:src="@drawable/widget_month_add"
            android:contentDescription="@string/widget_month_add_event" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_month_navigation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/widget_month_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_month_control_background"
            android:src="@drawable/widget_month_previous"
            android:contentDescription="@string/widget_month_previous" />
        <TextView
            android:id="@+id/widget_month_today"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_month_control_background"
            android:text="@string/widget_month_today"
            android:contentDescription="@string/widget_month_return_today"
            android:textColor="@color/semantic_action_text"
            android:textSize="14sp"
            android:maxLines="1"
            android:visibility="invisible" />
        <ImageButton
            android:id="@+id/widget_month_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_month_control_background"
            android:src="@drawable/widget_month_next"
            android:contentDescription="@string/widget_month_next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_month_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/widget_month_weekdays"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal" />
        <LinearLayout
            android:id="@+id/widget_month_weeks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_month_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:gravity="center"
        android:textColor="@color/semantic_on_surface_variant"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
