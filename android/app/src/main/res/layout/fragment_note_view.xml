<?xml version="1.0" encoding="utf-8"?>
<!-- The note viewer, which becomes the editor where the note can be edited. Banners come before the note's text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Why the note cannot be edited here: a read-only notebook, or a discard that did not finish. -->
    <TextView
        android:id="@+id/note_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_8"
        android:background="@color/semantic_surface_variant"
        android:padding="@dimen/spacing_16"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/semantic_on_surface"
        android:visibility="gone" />

    <!-- The editor's text went to Unsynced text, or could not be saved there: the way to it. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/note_open_unsynced"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/spacing_8"
        android:text="@string/notes_editor_open_unsynced"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/note_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <TextView
                android:id="@+id/note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/semantic_on_surface"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/note_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/semantic_on_surface_variant" />

            <TextView
                android:id="@+id/note_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:lineSpacingMultiplier="1.2"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/semantic_on_surface"
                android:textIsSelectable="true" />

            <!-- The editor's fields, whose own Cut and Copy mark the clip sensitive. saveEnabled is off: the text never goes into saved instance state, where a long
                 body would cross Binder. The keyboard is asked not to learn from it or suggest. No underline, as on a page: the body takes the room
                 below the title (the scroll view fills the screen), so a tap under the text lands in it. The title wraps (NoteViewFragment). -->
            <io.silentsuite.sync.ui.notes.SensitiveEditText
                android:id="@+id/note_title_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:paddingTop="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_8"
                android:minHeight="48dp"
                android:hint="@string/notes_editor_title_hint"
                android:importantForAutofill="no"
                android:imeOptions="flagNoPersonalizedLearning|actionNext"
                android:inputType="text|textNoSuggestions|textCapSentences"
                android:saveEnabled="false"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/note_editor_text"
                android:visibility="gone" />

            <io.silentsuite.sync.ui.notes.SensitiveEditText
                android:id="@+id/note_body_edit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/spacing_8"
                android:background="@null"
                android:paddingTop="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_8"
                android:gravity="top|start"
                android:minHeight="160dp"
                android:hint="@string/notes_editor_body_hint"
                android:importantForAutofill="no"
                android:imeOptions="flagNoPersonalizedLearning"
                android:inputType="textMultiLine|textNoSuggestions|textCapSentences"
                android:lineSpacingMultiplier="1.2"
                android:saveEnabled="false"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/note_editor_text"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Saved on this device, then synced or why it waits; or why the text was not saved. Announced when it changes. -->
    <TextView
        android:id="@+id/note_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_8"
        android:paddingBottom="@dimen/spacing_8"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/semantic_on_surface_variant"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/note_copy"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/spacing_8"
        android:text="@string/notes_held_copy"
        android:visibility="gone" />

</LinearLayout>
