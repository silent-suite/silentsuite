<?xml version="1.0" encoding="utf-8"?>
<!-- The account's Unsynced text: local text the notebook rows do not show, one card per entry file. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/held_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <TextView
            android:id="@+id/held_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notes_held_intro"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/semantic_on_surface_variant" />

        <TextView
            android:id="@+id/held_notebooks_failed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/notes_held_notebooks_failed"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/semantic_on_surface_variant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/held_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/semantic_on_surface"
            android:visibility="gone" />

        <TextView
            android:id="@+id/held_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/notes_held_empty"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/semantic_on_surface"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/held_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
