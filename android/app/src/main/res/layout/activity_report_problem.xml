<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <RadioGroup
            android:id="@+id/report_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/report_kind_problem"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/report_kind_problem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_16"
                android:text="@string/report_problem_kind_problem" />

            <RadioButton
                android:id="@+id/report_kind_feature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_problem_kind_feature" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/report_summary_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:hint="@string/report_problem_summary_hint"
            app:counterEnabled="true"
            app:counterMaxLength="120">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/report_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/report_description_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:hint="@string/report_problem_description_hint"
            app:counterEnabled="true"
            app:counterMaxLength="4000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/report_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/report_email_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:hint="@string/report_problem_email_hint"
            app:helperText="@string/report_problem_email_note"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/report_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/report_include_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:checked="true"
            android:text="@string/report_problem_include_diagnostics" />

        <LinearLayout
            android:id="@+id/report_preview_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/report_problem_preview_label" />

            <TextView
                android:id="@+id/report_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/report_disclosure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16" />

        <TextView
            android:id="@+id/report_privacy_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/report_problem_privacy_link"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/report_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/report_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/report_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/report_problem_send" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/report_email_instead"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_problem_email_instead" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/report_copy"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_problem_copy" />
    </LinearLayout>
</ScrollView>
