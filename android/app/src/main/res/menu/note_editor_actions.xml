<?xml version="1.0" encoding="utf-8"?>
<!-- The note editor's toolbar. Icon items: the titles are their TalkBack labels and long-press tooltips, and the
     tint dims an item that cannot be used now. They go to the overflow, with their titles, when there is no room. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item android:id="@+id/note_undo"
          android:title="@string/notes_editor_undo"
          android:icon="@drawable/ic_undo"
          app:iconTint="@color/note_editor_action"
          app:showAsAction="ifRoom"/>

    <item android:id="@+id/note_redo"
          android:title="@string/notes_editor_redo"
          android:icon="@drawable/ic_redo"
          app:iconTint="@color/note_editor_action"
          app:showAsAction="ifRoom"/>

    <!-- In the overflow only, away from Undo and Redo, and behind a picker. -->
    <item android:id="@+id/note_move"
          android:title="@string/notes_move_note"
          app:showAsAction="never"/>

    <!-- In the overflow only, away from Undo and Redo, and behind a confirmation. -->
    <item android:id="@+id/note_delete"
          android:title="@string/notes_delete_note"
          app:showAsAction="never"/>

</menu>
