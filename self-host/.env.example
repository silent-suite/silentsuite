# SilentSuite Self-Hosted Configuration
# Copy this file to .env and fill in your values.
# Or run the installer to generate everything automatically:
#   curl -fsSL https://raw.githubusercontent.com/silent-suite/silentsuite/main/self-host/install.sh | bash

# Server image, pinned to an immutable OCI index digest. install.sh verifies the
# release bundle and writes this line for you; there is no default, so Compose
# refuses to start rather than run an unverified or stale image.
#
# The digest must come from the server-image.json manifest published with the
# release you are installing. Supported runtime platforms are linux/amd64 and
# linux/arm64. A mutable :version tag is only ever used to find a release, never
# to select what runs.
SILENTSUITE_SERVER_IMAGE=

# Port the SilentSuite server listens on (default: 3735).
# Your reverse proxy should forward traffic to this port.
SERVER_PORT=3735

# Comma-separated reverse proxy IPs allowed to set X-Forwarded-* headers.
# Keep 127.0.0.1 for local host proxies. Use the exact Docker proxy container IP
# when a proxy container reaches the server over a Docker network.
TRUSTED_PROXY_IPS=127.0.0.1

# PostgreSQL password (auto-generated by install.sh)
DATABASE_PASSWORD=

# Django admin panel credentials (advanced use only).
# These are for the Etebase Django admin at https://YOUR_DOMAIN/admin/
# Most users don't need this — the first user to sign up in the
# SilentSuite app becomes the server admin automatically.
SUPER_USER=admin
SUPER_PASS=

# Open registration toggle. "false" allows new signups (default; needed for
# the first admin to register). Flip to "true" once the admin is registered.
ETEBASE_DISABLE_SIGNUP=false

# One-time first-admin signup token. install.sh auto-generates this value.
# Manual installs should set a strong random token before first boot; leaving it
# empty preserves the legacy open-first-signup behavior and does not protect the
# first account from public races.
# First signup server URL: https://YOUR_DOMAIN/?bootstrap_token=YOUR_TOKEN
# After the first account exists, this token is no longer required.
ETEBASE_BOOTSTRAP_ADMIN_TOKEN=

# Disable the advanced Django /admin/ panel entirely. Most self-hosters should
# leave this true and manage SilentSuite through the app.
ETEBASE_DISABLE_DJANGO_ADMIN=true

# Largest request body, in bytes, the server accepts for sign-up, login and
# password-change requests (allowed: 65536 to 1073741824). Raise it if those
# requests fail with "request_too_large", then recreate the server container.
ETEBASE_MAX_AUTH_REQUEST_BYTES=65536

# Largest request body, in bytes, for the app's other sync API requests
# (collections, items, members, invitations), including sync batches and
# attachment uploads (allowed: 1048576 to 1073741824). Neither limit covers the
# installation-owner login or the Django /admin/ panel. A reverse proxy in front
# of the server can enforce its own, lower limit.
ETEBASE_MAX_REQUEST_BYTES=67108864
